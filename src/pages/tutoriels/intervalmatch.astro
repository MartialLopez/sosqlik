{id:'syntaxe',n:'02',title:'Utiliser IntervalMatch()',level:'Avancé',intro:'Le champ passé à IntervalMatch doit déjà exister.',detail:'Le chargement associe ce champ aux bornes de la table d’intervalles.',example:`<pre><code>IntervalMatch (DateEvenement)
LOAD Debut, Fin
Resident Periodes;</code></pre>`,facts:[['IntervalMatch','champ à rattacher'],['Debut, Fin','bornes']],note:'Contrôlez les NULL et les limites.',advantages:['Syntaxe compacte'],disadvantages:['Modèle temporel à définir correctement']},
{id:'overlap',n:'03',title:'Attention aux chevauchements',level:'Avancé',intro:'Une valeur peut appartenir à plusieurs intervalles.',detail:'Ce n’est pas forcément une erreur : décidez si plusieurs correspondances sont autorisées.',example:`<div class="master-demo"><b>Contrôle</b><span>Une date → combien d’intervalles possibles ?</span><i>vérifier le grain</i></div>`,facts:[['chevauchement','plusieurs associations']],note:'Testez les dates aux limites.',advantages:['Comportement explicable'],disadvantages:['Risque de multiplication']}
];

// Coloration syntaxique Qlik Sense — palette globale SOSQLIK V4.40.
const qlikKeywords = new Set([
  'LOAD','FROM','WHERE','DISTINCT','AS','SQL','SELECT','LEFT','RIGHT','INNER','OUTER','JOIN','KEEP',
  'CONCATENATE','NOCONCATENATE','RESIDENT','GROUP','BY','MAPPING','STORE','INTO','DROP','TABLE','FIELD',
  'INLINE','ORDER','ASC','DESC','AUTOGENERATE','WHILE','IF','THEN','ELSE','ENDIF','LET','SET','QUALIFY',
  'UNQUALIFY','BINARY','SECTION','ACCESS','APPLICATION','REPLACE','ADD','MERGE','ONLY','ON','INSERT','UPDATE',
  'DELETE','IS','NULL','NOT','AND','OR','TRUE','FALSE','QVD','OOXML','TXT','EMBEDDED','LABELS'
]);

function escapeCode(value) {
  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function highlightQlik(code) {
  let out = '';
  let i = 0;
  const len = code.length;
  while (i < len) {
    if (code.startsWith('//', i)) {
      const end = code.indexOf('\n', i);
      const stop = end === -1 ? len : end;
      out += `<span class="qs-comment">${escapeCode(code.slice(i, stop))}</span>`;
      i = stop;
      continue;
    }
    const ch = code[i];
    if (ch === "'") {
      let j = i + 1;
      while (j < len) {
        if (code[j] === "'" && code[j + 1] === "'") { j += 2; continue; }
        if (code[j] === "'") { j++; break; }
        j++;
      }
      out += `<span class="qs-string">${escapeCode(code.slice(i, j))}</span>`;
      i = j;
      continue;
    }
    if (ch === '[') {
      const end = code.indexOf(']', i + 1);
      if (end !== -1) {
        const token = code.slice(i, end + 1);
        const cls = token.includes('lib://') ? 'qs-string' : 'qs-field';
        out += `<span class="${cls}">${escapeCode(token)}</span>`;
        i = end + 1;
        continue;
      }
    }
    if (/\d/.test(ch)) {
      const m = code.slice(i).match(/^\d+(?:[.,]\d+)?/);
      out += `<span class="qs-number">${m[0]}</span>`;
      i += m[0].length;
      continue;
    }
    if (/[A-Za-zÀ-ÿ_$]/.test(ch)) {
      const m = code.slice(i).match(/^[A-Za-zÀ-ÿ_$][A-Za-zÀ-ÿ0-9_.$]*/);
      const word = m[0];
      const upper = word.toUpperCase();
      let j = i + word.length;
      while (j < len && /\s/.test(code[j])) j++;
      let cls = '';
      if (qlikKeywords.has(upper)) cls = 'qs-keyword';
      else if (code[j] === '(') cls = 'qs-function';
      else if (/^[A-ZÀ-ÖØ-Þ][A-ZÀ-ÖØ-Þ0-9_.$]*$/.test(word) || word.includes('_')) cls = 'qs-field';
      if (cls) out += `<span class="${cls}">${escapeCode(word)}</span>`;
      else out += escapeCode(word);
      i += word.length;
      continue;
    }
    if ('=+-*/<>'.includes(ch)) {
      out += `<span class="qs-operator">${escapeCode(ch)}</span>`;
      i++;
      continue;
    }
    out += escapeCode(ch);
    i++;
  }
  return out;
}

function colorizeExample(html) {
  return html.replace(/<pre><code>([\s\S]*?)<\/code><\/pre>/g, (_match, code) =>
    `<pre><code class="qlik-syntax">${highlightQlik(code)}</code></pre>`
  );
}

for (const lesson of lessons) lesson.example = colorizeExample(lesson.example);

