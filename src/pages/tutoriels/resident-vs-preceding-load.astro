---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TutorialLayout from '../../components/TutorialLayout.astro';
const lessons=[
{id:'principe',n:'01',title:'Deux façons d’enchaîner les transformations',level:'Intermédiaire',intro:'Resident Load et Preceding Load appliquent plusieurs étapes de transformation.',detail:'Resident relit une table déjà matérialisée. Preceding empile un LOAD au-dessus du chargement qui le suit.',example:`<pre><code>// Resident
Final:
LOAD ID, Date(DateBrute) AS Date
Resident Source;</code></pre>`,facts:[['Resident','table déjà chargée'],['Preceding','LOAD au-dessus du suivant']],note:'Le choix dépend surtout du traitement et de la lisibilité.',advantages:['Techniques complémentaires'],disadvantages:['Ne pas choisir par habitude']},
{id:'preceding',n:'02',title:'Le Preceding Load',level:'Intermédiaire',intro:'Le LOAD supérieur reçoit le résultat du LOAD situé dessous.',detail:'Le flux se comprend de bas en haut.',example:`<pre><code>LOAD ID, Date(DateBrute) AS Date;
LOAD ID, Timestamp#(DateTexte,'YYYY-MM-DD hh:mm:ss') AS DateBrute
FROM [lib://Donnees/Source.qvd] (qvd);</code></pre>`,facts:[['LOAD inférieur','prépare'],['LOAD supérieur','transforme']],note:'Gardez des noms intermédiaires explicites.',advantages:['Pas de table temporaire nommée'],disadvantages:['Lecture moins intuitive au début']},
{id:'resident',n:'03',title:'Quand Resident est plus naturel',level:'Intermédiaire',intro:'Resident convient lorsqu’une étape doit être réutilisée ou traitée séparément.',detail:'La table source existe en mémoire et peut alimenter plusieurs traitements.',example:`<pre><code>CA_Client:
LOAD ID_CLIENT, Sum(CA_HT) AS CA_CLIENT
Resident Commandes
Group By ID_CLIENT;

DROP TABLE Commandes;</code></pre>`,facts:[['Resident','réutilisation'],['DROP TABLE','nettoyage']],note:'Resident est souvent plus pédagogique pour plusieurs branches.',advantages:['Lisible et réutilisable'],disadvantages:['Mémoire temporaire']},
{id:'choisir',n:'04',title:'Comment choisir ?',level:'Intermédiaire',intro:'Il n’existe pas de gagnant universel.',detail:'Chaîne linéaire : Preceding est souvent naturel. Réutilisation ou étape explicite : Resident est souvent plus clair.',example:`<div class="master-demo"><b>Réflexe SOSQLIK</b><span>Chaîne simple → Preceding · Étape réutilisée → Resident</span><i>privilégier la lisibilité</i></div>`,facts:[['linéaire','Preceding'],['réutilisation','Resident']],note:'Mesurez sur vos données si le volume rend le choix sensible.',advantages:['Choix raisonné'],disadvantages:['Certains scripts utilisent les deux']}
];

// Coloration syntaxique Qlik Sense — palette globale SOSQLIK V4.40.
const qlikKeywords = new Set([
  'LOAD','FROM','WHERE','DISTINCT','AS','SQL','SELECT','LEFT','RIGHT','INNER','OUTER','JOIN','KEEP',
  'CONCATENATE','NOCONCATENATE','RESIDENT','GROUP','BY','MAPPING','STORE','INTO','DROP','TABLE','FIELD',
  'INLINE','ORDER','ASC','DESC','AUTOGENERATE','WHILE','IF','THEN','ELSE','ENDIF','LET','SET','QUALIFY',
  'UNQUALIFY','BINARY','SECTION','ACCESS','APPLICATION','REPLACE','ADD','MERGE','ONLY','ON','INSERT','UPDATE',
  'DELETE','IS','NULL','NOT','AND','OR','TRUE','FALSE','QVD','OOXML','TXT','EMBEDDED','LABELS'
]);

function escapeCode(value) {
  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function highlightQlik(code) {
  let out = '';
  let i = 0;
  const len = code.length;
  while (i < len) {
    if (code.startsWith('//', i)) {
      const end = code.indexOf('\n', i);
      const stop = end === -1 ? len : end;
      out += `<span class="qs-comment">${escapeCode(code.slice(i, stop))}</span>`;
      i = stop;
      continue;
    }
    const ch = code[i];
    if (ch === "'") {
      let j = i + 1;
      while (j < len) {
        if (code[j] === "'" && code[j + 1] === "'") { j += 2; continue; }
        if (code[j] === "'") { j++; break; }
        j++;
      }
      out += `<span class="qs-string">${escapeCode(code.slice(i, j))}</span>`;
      i = j;
      continue;
    }
    if (ch === '[') {
      const end = code.indexOf(']', i + 1);
      if (end !== -1) {
        const token = code.slice(i, end + 1);
        const cls = token.includes('lib://') ? 'qs-string' : 'qs-field';
        out += `<span class="${cls}">${escapeCode(token)}</span>`;
        i = end + 1;
        continue;
      }
    }
    if (/\d/.test(ch)) {
      const m = code.slice(i).match(/^\d+(?:[.,]\d+)?/);
      out += `<span class="qs-number">${m[0]}</span>`;
      i += m[0].length;
      continue;
    }
    if (/[A-Za-zÀ-ÿ_$]/.test(ch)) {
      const m = code.slice(i).match(/^[A-Za-zÀ-ÿ_$][A-Za-zÀ-ÿ0-9_.$]*/);
      const word = m[0];
      const upper = word.toUpperCase();
      let j = i + word.length;
      while (j < len && /\s/.test(code[j])) j++;
      let cls = '';
      if (qlikKeywords.has(upper)) cls = 'qs-keyword';
      else if (code[j] === '(') cls = 'qs-function';
      else if (/^[A-ZÀ-ÖØ-Þ][A-ZÀ-ÖØ-Þ0-9_.$]*$/.test(word) || word.includes('_')) cls = 'qs-field';
      if (cls) out += `<span class="${cls}">${escapeCode(word)}</span>`;
      else out += escapeCode(word);
      i += word.length;
      continue;
    }
    if ('=+-*/<>'.includes(ch)) {
      out += `<span class="qs-operator">${escapeCode(ch)}</span>`;
      i++;
      continue;
    }
    out += escapeCode(ch);
    i++;
  }
  return out;
}

function colorizeExample(html) {
  return html.replace(/<pre><code>([\s\S]*?)<\/code><\/pre>/g, (_match, code) =>
    `<pre><code class="qlik-syntax">${highlightQlik(code)}</code></pre>`
  );
}

for (const lesson of lessons) lesson.example = colorizeExample(lesson.example);

---
<BaseLayout title="Resident Load ou Preceding Load — SOSQLIK"><TutorialLayout title="Resident Load ou Preceding Load ?" description="Comprendre les deux techniques et choisir la plus lisible selon le traitement." navTitle="Resident vs Preceding" lessons={lessons}/></BaseLayout>
