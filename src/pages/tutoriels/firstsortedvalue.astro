<BaseLayout title="FirstSortedValue — SOSQLIK"><TutorialLayout title="Maîtriser FirstSortedValue()" description="Retrouver une valeur selon un ordre et comprendre le piège des ex æquo." navTitle="FirstSortedValue()" lessons={lessons}/></BaseLayout>
