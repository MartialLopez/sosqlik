---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TutorialLayout from '../../components/TutorialLayout.astro';
const lessons=[
{id:'qualify',n:'01',title:'Pourquoi QUALIFY existe',level:'Intermédiaire',intro:'Qlik associe automatiquement les champs de même nom.',detail:'QUALIFY préfixe les champs par le nom de table pour empêcher des associations non souhaitées.',example:`<pre><code>QUALIFY *;

Clients:
LOAD ID, Nom, Ville
FROM [lib://Donnees/Clients.qvd] (qvd);</code></pre>`,facts:[['QUALIFY *','qualifie les champs']],note:'C’est un outil de contrôle, pas une architecture.',advantages:['Évite des associations accidentelles'],disadvantages:['Peut aussi supprimer les associations voulues']},
{id:'unqualify',n:'02',title:'Conserver les vraies clés avec UNQUALIFY',level:'Intermédiaire',intro:'Les clés voulues doivent garder un nom commun.',detail:'UNQUALIFY exclut certains champs de la qualification.',example:`<pre><code>QUALIFY *;
UNQUALIFY ID_CLIENT;

Clients:
LOAD ID_CLIENT, Nom, Ville FROM [lib://Donnees/Clients.qvd] (qvd);

Commandes:
LOAD ID_CLIENT, ID_COMMANDE, Montant FROM [lib://Donnees/Commandes.qvd] (qvd);</code></pre>`,facts:[['ID_CLIENT','reste commun']],note:'La clé reste associative.',advantages:['Contrôle fin'],disadvantages:['Il faut connaître les clés']},
{id:'prudence',n:'03',title:'Quand éviter QUALIFY',level:'Intermédiaire',intro:'Un bon modèle commence par des noms de champs maîtrisés.',detail:'QUALIFY peut masquer un problème de conception si on l’utilise partout.',example:`<div class="master-demo"><b>Réflexe SOSQLIK</b><span>Comprendre les associations avant de les neutraliser</span><i>contrôler le Data Model Viewer</i></div>`,facts:[['modèle','comprendre d’abord'],['QUALIFY','contrôler ensuite']],note:'Le tutoriel Modèle associatif reste la référence sur les clés.',advantages:['Usage ciblé'],disadvantages:['Usage global difficile à maintenir']}
];

// Coloration syntaxique Qlik Sense — palette globale SOSQLIK V4.40.
const qlikKeywords = new Set([
  'LOAD','FROM','WHERE','DISTINCT','AS','SQL','SELECT','LEFT','RIGHT','INNER','OUTER','JOIN','KEEP',
  'CONCATENATE','NOCONCATENATE','RESIDENT','GROUP','BY','MAPPING','STORE','INTO','DROP','TABLE','FIELD',
  'INLINE','ORDER','ASC','DESC','AUTOGENERATE','WHILE','IF','THEN','ELSE','ENDIF','LET','SET','QUALIFY',
  'UNQUALIFY','BINARY','SECTION','ACCESS','APPLICATION','REPLACE','ADD','MERGE','ONLY','ON','INSERT','UPDATE',
  'DELETE','IS','NULL','NOT','AND','OR','TRUE','FALSE','QVD','OOXML','TXT','EMBEDDED','LABELS'
]);

function escapeCode(value) {
  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function highlightQlik(code) {
  let out = '';
  let i = 0;
  const len = code.length;
  while (i < len) {
    if (code.startsWith('//', i)) {
      const end = code.indexOf('\n', i);
      const stop = end === -1 ? len : end;
      out += `<span class="qs-comment">${escapeCode(code.slice(i, stop))}</span>`;
      i = stop;
      continue;
    }
    const ch = code[i];
    if (ch === "'") {
      let j = i + 1;
      while (j < len) {
        if (code[j] === "'" && code[j + 1] === "'") { j += 2; continue; }
        if (code[j] === "'") { j++; break; }
        j++;
      }
      out += `<span class="qs-string">${escapeCode(code.slice(i, j))}</span>`;
      i = j;
      continue;
    }
    if (ch === '[') {
      const end = code.indexOf(']', i + 1);
      if (end !== -1) {
        const token = code.slice(i, end + 1);
        const cls = token.includes('lib://') ? 'qs-string' : 'qs-field';
        out += `<span class="${cls}">${escapeCode(token)}</span>`;
        i = end + 1;
        continue;
      }
    }
    if (/\d/.test(ch)) {
      const m = code.slice(i).match(/^\d+(?:[.,]\d+)?/);
      out += `<span class="qs-number">${m[0]}</span>`;
      i += m[0].length;
      continue;
    }
    if (/[A-Za-zÀ-ÿ_$]/.test(ch)) {
      const m = code.slice(i).match(/^[A-Za-zÀ-ÿ_$][A-Za-zÀ-ÿ0-9_.$]*/);
      const word = m[0];
      const upper = word.toUpperCase();
      let j = i + word.length;
      while (j < len && /\s/.test(code[j])) j++;
      let cls = '';
      if (qlikKeywords.has(upper)) cls = 'qs-keyword';
      else if (code[j] === '(') cls = 'qs-function';
      else if (/^[A-ZÀ-ÖØ-Þ][A-ZÀ-ÖØ-Þ0-9_.$]*$/.test(word) || word.includes('_')) cls = 'qs-field';
      if (cls) out += `<span class="${cls}">${escapeCode(word)}</span>`;
      else out += escapeCode(word);
      i += word.length;
      continue;
    }
    if ('=+-*/<>'.includes(ch)) {
      out += `<span class="qs-operator">${escapeCode(ch)}</span>`;
      i++;
      continue;
    }
    out += escapeCode(ch);
    i++;
  }
  return out;
}

function colorizeExample(html) {
  return html.replace(/<pre><code>([\s\S]*?)<\/code><\/pre>/g, (_match, code) =>
    `<pre><code class="qlik-syntax">${highlightQlik(code)}</code></pre>`
  );
}

for (const lesson of lessons) lesson.example = colorizeExample(lesson.example);

