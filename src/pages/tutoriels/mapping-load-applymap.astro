import BaseLayout from '../../layouts/BaseLayout.astro';
import TutorialLayout from '../../components/TutorialLayout.astro';
const lessons=[
{id:'mapping',n:'01',title:'Construire une table de mapping',level:'Intermédiaire',intro:'Mapping LOAD crée une correspondance à deux colonnes.',detail:'La première colonne contient la clé recherchée et la seconde la valeur retournée.',example:`<pre><code>MapPays:
Mapping LOAD CODE_PAYS, LIBELLE_PAYS
FROM [lib://Donnees/Pays.qvd] (qvd);</code></pre>`,facts:[['colonne 1','clé'],['colonne 2','valeur']],note:'Ce n’est pas une table classique du modèle final.',advantages:['Simple et efficace'],disadvantages:['Correspondance à deux colonnes']},
{id:'applymap',n:'02',title:'Appliquer le mapping',level:'Intermédiaire',intro:'ApplyMap() recherche la clé et renvoie la valeur associée.',detail:'Le troisième paramètre définit la valeur retournée en l’absence de correspondance.',example:`<pre><code>Clients:
LOAD ID_CLIENT, CODE_PAYS,
    ApplyMap('MapPays', CODE_PAYS, 'Inconnu') AS PAYS
FROM [lib://Donnees/Clients.qvd] (qvd);</code></pre>`,facts:[['MapPays','mapping'],['3e paramètre','valeur par défaut']],note:'L’astuce ApplyMap() existante couvre déjà le cas simple face au JOIN.',advantages:['Lisible'],disadvantages:['Mapping chargé avant utilisation']},
{id:'join',n:'03',title:'Mapping ou JOIN ?',level:'Intermédiaire',intro:'ApplyMap() n’est pas meilleur que JOIN dans l’absolu.',detail:'Quelques attributs indépendants se prêtent bien aux mappings. Pour de nombreuses colonnes liées, réévaluez le modèle, le JOIN ou l’association naturelle.',example:`<pre><code>ApplyMap('MapPays', CODE_PAYS, 'Inconnu') AS PAYS,
ApplyMap('MapSegment', ID_CLIENT, 'Non classé') AS SEGMENT</code></pre>`,facts:[['quelques attributs','mapping'],['beaucoup de colonnes','réévaluer']],note:'Choisissez selon le besoin.',advantages:['Évite des JOIN inutiles'],disadvantages:['Trop de mappings nuit à la lisibilité']},
{id:'default',n:'04',title:'Soigner la valeur par défaut',level:'Intermédiaire',intro:'Une absence de correspondance doit être traitée consciemment.',detail:'Une valeur explicite facilite les contrôles qualité.',example:`<pre><code>ApplyMap('MapProduit', ID_PRODUIT, 'Produit inconnu') AS PRODUIT</code></pre>`,facts:[['défaut','contrôle qualité']],note:'Ne masquez pas silencieusement une anomalie.',advantages:['Contrôle simple'],disadvantages:['Un mauvais défaut peut masquer un problème']}
];
---
<BaseLayout title="Mapping LOAD et ApplyMap — SOSQLIK"><TutorialLayout title="Mapping LOAD et ApplyMap()" description="Approfondir les mappings, les valeurs absentes et le choix face à une jointure." navTitle="Mapping / ApplyMap" lessons={lessons}/></BaseLayout>
