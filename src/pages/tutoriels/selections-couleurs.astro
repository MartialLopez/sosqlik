---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TutorialLayout from '../../components/TutorialLayout.astro';
const lessons = [{'id': 'intro',
  'n': '',
  'title': 'Le cœur de la navigation Qlik',
  'level': 'Fondamentaux',
  'icon': '◉',
  'explain': 'Qlik ne se contente pas de filtrer : il montre ce qui est sélectionné, possible, alternatif ou exclu.',
  'detail': 'Les couleurs traduisent le résultat du moteur associatif et deviennent une information d’analyse.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Région = Sud → Qlik recalcule tous les champs</span></div>',
  'facts': [['Vert', 'Sélectionné'], ['Blanc', 'Possible'], ['Gris', 'Alternatif / exclu']],
  'note': 'Lire les couleurs aide à comprendre les associations.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'vert',
  'n': '1',
  'title': 'Vert — sélectionné',
  'level': 'Essentiel',
  'icon': '✓',
  'explain': 'Vert avec une coche signifie sélectionné.',
  'detail': 'La valeur fait partie des choix actifs de l’utilisateur.',
  'example': '<div class="master-demo"><b>Exemple</b><span>✓ Sud</span></div>',
  'facts': [['Couleur', 'Vert'], ['État', 'Sélectionné']],
  'note': 'Plusieurs valeurs peuvent être sélectionnées.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'blanc',
  'n': '2',
  'title': 'Blanc — possible',
  'level': 'Essentiel',
  'icon': '○',
  'explain': 'Une valeur blanche reste compatible avec toutes les sélections actives.',
  'detail': 'Après Région = Sud, les clients associés au Sud restent possibles tant qu’ils ne sont pas sélectionnés.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Sud → Sonia reste possible</span></div>',
  'facts': [['Couleur', 'Blanc'], ['État', 'Possible']],
  'note': 'Blanc signifie compatible avec le contexte.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'gris-clair',
  'n': '3',
  'title': 'Gris clair — alternatif',
  'level': 'Essentiel',
  'icon': '◐',
  'explain': 'Une valeur alternative aurait été possible si une autre valeur du même champ n’était pas déjà sélectionnée.',
  'detail': 'Avec Sud sélectionné dans Région, Nord peut être alternatif : il pourrait remplacer le choix courant.',
  'example': '<div class="master-demo"><b>Exemple</b><span>✓ Sud · Nord alternatif</span></div>',
  'facts': [['Couleur', 'Gris clair'], ['État', 'Alternatif']],
  'note': 'Gris clair ne signifie pas impossible.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'gris-fonce',
  'n': '4',
  'title': 'Gris foncé — exclu',
  'level': 'Essentiel',
  'icon': '×',
  'explain': 'Une valeur exclue n’est pas compatible avec les sélections courantes.',
  'detail': 'Si Produit Z n’a aucune donnée associée au Sud, il devient exclu après la sélection de Sud.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Sud → Produit Z exclu</span></div>',
  'facts': [['Couleur', 'Gris foncé'], ['État', 'Exclu']],
  'note': 'Une exclusion inattendue peut révéler une information métier.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'sel-exclu',
  'n': '5',
  'title': 'Gris foncé + coche — sélectionné exclu',
  'level': 'Intermédiaire',
  'icon': '☑',
  'explain': 'La valeur avait été sélectionnée puis une autre sélection l’a rendue incompatible.',
  'detail': 'La coche rappelle le choix initial ; le gris foncé montre qu’il est désormais exclu.',
  'example': '<div class="master-demo"><b>Exemple</b><span>✓ 2025 → autre choix → 2025 gris + ✓</span></div>',
  'facts': [['Coche', 'Était sélectionné'], ['Gris', 'Désormais exclu']],
  'note': 'Très utile pour comprendre une contradiction de sélection.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'barre',
  'n': '6',
  'title': 'Barre de sélections et historique',
  'level': 'Essentiel',
  'icon': '↶',
  'explain': 'La barre de sélections montre le contexte actif ; retour et avance permettent de parcourir l’historique.',
  'detail': 'Avant de chercher un bug dans une expression, vérifiez toujours les sélections actives et les éventuels verrous.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Sud → 2026 → Produit A → retour</span></div>',
  'facts': [['Barre', 'Contexte actif'], ['Retour', 'État précédent'], ['Avance', 'État suivant']],
  'note': 'L’historique n’est pas un favori durable.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'gris-info',
  'n': '7',
  'title': 'Le gris est une information',
  'level': 'À retenir',
  'icon': '💡',
  'explain': 'Qlik laisse visibles les valeurs exclues : ce qui ne correspond pas peut être aussi instructif que ce qui correspond.',
  'detail': 'Un produit qui devient gris sur un trimestre peut révéler une absence de vente, une rupture ou un problème de données.',
  'example': '<div class="master-demo"><b>Exemple</b><span>T2 → Produit C gris → Pourquoi ?</span></div>',
  'facts': [['Gris attendu', 'Contexte normal'], ['Gris inattendu', 'Piste d’analyse']],
  'note': 'C’est une force majeure du modèle associatif.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'methode',
  'n': '8',
  'title': 'Ma méthode recommandée',
  'level': 'À retenir',
  'icon': '✓',
  'explain': 'Quand un résultat surprend, lisez d’abord le contexte de sélection.',
  'detail': 'Regardez le vert, le blanc, les gris, la barre de sélections et les verrous avant de modifier une expression.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Vert → blanc → gris → barre → verrous</span></div>',
  'facts': [['1', 'Sélectionné'], ['2', 'Possible'], ['3', 'Exclu']],
  'note': 'Les couleurs peuvent être modifiées par un thème personnalisé.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']}];
const sources = [{'label': 'Qlik Help — Selection states',
  'url': 'https://help.qlik.com/en-US/cloud-services/Subsystems/Hub/Content/Sense_Hub/Selections/selection-states.htm'},
 {'label': 'Qlik Help — Associative selection model',
  'url': 'https://help.qlik.com/en-US/sense/May2026/Subsystems/Hub/Content/Sense_Hub/Selections/associative-selection-model.htm'},
 {'label': 'Qlik Help — Exploring with selections',
  'url': 'https://help.qlik.com/en-US/sense/November2025/Subsystems/Hub/Content/Sense_Hub/Selections/SelectionsToolbar/work-with-selections.htm'}];
import RelatedContent from '../../components/RelatedContent.astro';
---
<BaseLayout title="Comprendre les sélections et les couleurs dans Qlik — SOSQLIK">
  <TutorialLayout title="Comprendre les sélections et les couleurs dans Qlik" description="Vert, blanc, gris clair, gris foncé : apprendre à lire les états de sélection et à naviguer dans le modèle associatif." navTitle="Sélections & couleurs" lessons={lessons}
    sourceTitle="Références Qlik" sourceText="Tutoriel fondé sur la documentation officielle Qlik, avec exemples et explications SOSQLIK reformulés pour un usage pratique." sourceLinks={sources} />

<RelatedContent links={[
  { href: '/tutoriels/modele-associatif', kind: 'Tutoriel', title: 'Modèle associatif', description: 'Revenir aux principes qui expliquent les états de sélection.' }
]} />
</BaseLayout>
