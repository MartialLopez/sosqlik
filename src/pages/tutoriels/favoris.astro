---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TutorialLayout from '../../components/TutorialLayout.astro';
const lessons = [{'id': 'intro',
  'n': '',
  'title': 'Pourquoi utiliser les favoris ?',
  'level': 'Fondamentaux',
  'icon': '★',
  'explain': 'Un favori mémorise un état d’analyse pour le retrouver plus tard.',
  'detail': 'Il évite de reconstruire les mêmes sélections et devient très utile pour les analyses récurrentes.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Année = 2026 · Région = Sud</span></div>',
  'facts': [['But', 'Retrouver une analyse'], ['Gain', 'Temps + reproductibilité']],
  'note': 'Un favori mémorise un contexte, pas une copie des données.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'creer',
  'n': '1',
  'title': 'Créer son premier favori',
  'level': 'Essentiel',
  'icon': '＋',
  'explain': 'Faites les sélections à conserver puis créez un nouveau favori.',
  'detail': 'Donnez-lui un titre métier clair et, si besoin, une description.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Ventes Sud — année 2026</span></div>',
  'facts': [['1', 'Faire les sélections'], ['2', 'Créer'], ['3', 'Nommer']],
  'note': 'Évitez les titres génériques.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'appliquer',
  'n': '2',
  'title': 'Appliquer un favori',
  'level': 'Essentiel',
  'icon': '▶',
  'explain': 'Appliquer un favori restaure les sélections enregistrées.',
  'detail': 'Selon les options, Qlik peut aussi ouvrir la feuille mémorisée et restaurer certains états de présentation.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Favori → Année 2026 · Région Sud</span></div>',
  'facts': [['Sélections', 'Restaurées'], ['Feuille', 'Selon option']],
  'note': 'On peut aussi appliquer uniquement les sélections selon le contexte.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'feuille-layout',
  'n': '3',
  'title': 'Feuille et disposition',
  'level': 'Pratique',
  'icon': '▦',
  'explain': 'Un favori peut mémoriser la feuille et certains éléments de disposition.',
  'detail': 'La feuille peut être restaurée à l’application du favori. La sauvegarde de disposition peut conserver notamment tris et expansions, mais pas la position de défilement.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Sélections + feuille + disposition</span></div>',
  'facts': [['Feuille', 'Optionnelle'], ['Layout', 'Optionnel'], ['Scroll', 'Non mémorisé']],
  'note': 'N’activez que ce qui fait réellement partie du scénario.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'variables',
  'n': '4',
  'title': 'Favoris et variables',
  'level': 'Intermédiaire',
  'icon': 'x',
  'explain': 'Les états de variables peuvent être inclus dans un favori lorsque la configuration le permet.',
  'detail': 'Qlik permet un contrôle variable par variable. Les variables créées dans le script de chargement ne peuvent pas avoir leur état sauvegardé ainsi.',
  'example': '<div class="master-demo"><b>Exemple</b><span>vScenario = Budget</span></div>',
  'facts': [['Variable UI', 'Peut être incluse'], ['Variable script', 'État non sauvegardable ainsi']],
  'note': 'Testez les favoris qui pilotent des scénarios par variables.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'dynamique',
  'n': '5',
  'title': 'Les favoris dynamiques',
  'level': 'Intermédiaire',
  'icon': '↻',
  'explain': 'Un favori peut utiliser une recherche de sélection dynamique plutôt que des valeurs figées.',
  'detail': 'C’est utile pour une période courante ou un critère qui doit évoluer avec les données.',
  'example': '<div class="master-demo"><b>Exemple</b><span>=YearMonth>=QuarterStart(Now(),-1)</span></div>',
  'facts': [['Statique', 'Valeurs précises'], ['Dynamique', 'Recherche de sélection']],
  'note': 'Testez la recherche avant de partager le favori.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'partage',
  'n': '6',
  'title': 'Privé, public et partage',
  'level': 'Pratique',
  'icon': '👥',
  'explain': 'Les favoris peuvent servir à un usage personnel ou collectif selon l’environnement et les droits.',
  'detail': 'Un favori partagé doit être nommé et décrit comme un véritable élément de l’application.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Direction — CA mensuel de référence</span></div>',
  'facts': [['Privé', 'Usage personnel'], ['Public', 'Usage collectif']],
  'note': 'Quelques favoris clairs valent mieux qu’une longue liste.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'maj',
  'n': '7',
  'title': 'Mettre à jour un favori',
  'level': 'Pratique',
  'icon': '✎',
  'explain': 'Un favori privé peut être mis à jour avec de nouvelles sélections.',
  'detail': 'Les nouvelles sélections remplacent celles enregistrées auparavant.',
  'example': '<div class="master-demo"><b>Exemple</b><span>2025 → mise à jour → 2026</span></div>',
  'facts': [['Action', 'Nouvelles sélections'], ['Effet', 'Remplacement']],
  'note': 'Mettez aussi à jour le titre si le sens métier change.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']},
 {'id': 'methode',
  'n': '8',
  'title': 'Ma méthode recommandée',
  'level': 'À retenir',
  'icon': '✓',
  'explain': 'Créez un favori lorsqu’un état d’analyse a une vraie valeur de réutilisation.',
  'detail': 'Sélections utiles, titre métier, puis feuille, layout ou variables uniquement si nécessaire.',
  'example': '<div class="master-demo"><b>Exemple</b><span>Sélections → objectif → nom → options → test</span></div>',
  'facts': [['1', 'Construire'], ['2', 'Sauvegarder'], ['3', 'Tester']],
  'note': 'Faites régulièrement le ménage dans les favoris.',
  'advantages': ['Compréhension et navigation plus rapides'],
  'disadvantages': ['À adapter au contexte de l’application']}];
const sources = [{'label': 'Qlik Help — Creating bookmarks',
  'url': 'https://help.qlik.com/en-US/sense/November2025/Subsystems/Hub/Content/Sense_Hub/Bookmarks/create-bookmark.htm'}];
---
<BaseLayout title="Bien utiliser les favoris dans Qlik — SOSQLIK">
  <TutorialLayout title="Bien utiliser les favoris dans Qlik" description="Créer, appliquer, partager et organiser les favoris pour retrouver rapidement un état d’analyse utile." navTitle="Favoris" lessons={lessons}
    sourceTitle="Références Qlik" sourceText="Tutoriel fondé sur la documentation officielle Qlik, avec exemples et explications SOSQLIK reformulés pour un usage pratique." sourceLinks={sources} />
</BaseLayout>
