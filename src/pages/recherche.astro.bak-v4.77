---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Recherche · SOSQLIK" description="Rechercher dans l'ensemble des contenus SOSQLIK.">
<section class="search-page"><div class="container">
<div class="search-page-head"><span class="search-kicker">RECHERCHE SOSQLIK</span><h1>Que cherchez-vous ?</h1>
<p>Recherchez dans l’ensemble des pages, tutoriels, astuces et articles SOSQLIK.</p>
<form class="search-page-form" action="/recherche" method="get" role="search">
<span aria-hidden="true">⌕</span><input id="global-search-input" name="q" type="search" placeholder="Ex. ApplyMap, Set Analysis, MERGE, Custom filter…" autocomplete="off" aria-label="Rechercher dans SOSQLIK"><button type="submit">Rechercher</button>
</form></div>
<div id="search-summary" class="search-summary" aria-live="polite"></div><div id="search-results" class="search-results"></div>
<div id="search-empty" class="search-empty" hidden><h2>Aucun résultat</h2><p>Essayez avec un terme plus court ou un autre mot-clé.</p></div>
</div></section>
<script is:inline>
(()=>{const input=document.getElementById('global-search-input'),results=document.getElementById('search-results'),summary=document.getElementById('search-summary'),empty=document.getElementById('search-empty'),form=document.querySelector('.search-page-form');if(!input||!results||!summary||!empty||!form)return;
const norm=v=>String(v||'').toLocaleLowerCase('fr').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
const esc=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let index=[];
function excerpt(text,terms){const n=norm(text);let pos=-1;for(const term of terms){const p=n.indexOf(term);if(p!==-1&&(pos===-1||p<pos))pos=p}if(pos<0)pos=0;const start=Math.max(0,pos-100),end=Math.min(text.length,pos+260);return(start?'…':'')+text.slice(start,end).trim()+(end<text.length?'…':'')}
function run(query){const clean=query.trim();results.innerHTML='';empty.hidden=true;if(!clean){summary.textContent='Saisissez un mot ou une expression pour lancer la recherche.';return}const terms=norm(clean).split(/\s+/).filter(Boolean);
const found=index.map(item=>{const title=norm(item.title),text=norm(item.text);let score=0;for(const term of terms){const a=title.includes(term),b=text.includes(term);if(!a&&!b)return null;if(a)score+=30;if(b)score+=5}if(title===norm(clean))score+=50;return{...item,score}}).filter(Boolean).sort((a,b)=>b.score-a.score||a.title.localeCompare(b.title,'fr'));
summary.textContent=`${found.length} résultat${found.length>1?'s':''} pour « ${clean} »`;empty.hidden=found.length!==0;
for(const item of found){const card=document.createElement('article');card.className='search-result-card';const sep=item.url.includes('?')?'&':'?';const deepUrl=item.url+sep+'find='+encodeURIComponent(clean);card.innerHTML=`<div class="search-result-meta">${esc(item.type)}</div><h2><a href="${esc(deepUrl)}">${esc(item.title)}</a></h2><p>${esc(excerpt(item.text,terms))}</p><a class="search-result-link" href="${esc(deepUrl)}">Ouvrir au bon endroit →</a>`;results.appendChild(card)}}
async function init(){const q=new URLSearchParams(location.search).get('q')||'';input.value=q;summary.textContent='Chargement de l’index…';try{const r=await fetch('/search-index.json',{cache:'no-store'});if(!r.ok)throw new Error(`HTTP ${r.status}`);index=await r.json();run(q)}catch(e){console.error(e);summary.textContent='L’index de recherche est indisponible.'}}
form.addEventListener('submit',e=>{e.preventDefault();const q=input.value.trim();history.replaceState(null,'',q?`/recherche?q=${encodeURIComponent(q)}`:'/recherche');run(q)});init()})();
</script></BaseLayout>
