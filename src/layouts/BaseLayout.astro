---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'SOSBI',
  description = 'Astuces, tutoriels et retours d’expérience autour de Qlik.'
} = Astro.props;
---
<!doctype html>
<html lang="fr">
<head>
  <meta name="robots" content="noindex, nofollow">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon.svg" />
  <title>{title}</title>
  <script is:inline>
    (() => {
      const saved = localStorage.getItem('sosqlik-theme');
      const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = saved || preferred;
    })();
  </script>
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />

  <button id="sosqlik-back-to-top" class="sosqlik-back-to-top" type="button" aria-label="Retour en haut de page" title="Retour en haut de page">↑</button>

  <style is:global>
    .sosqlik-back-to-top{position:fixed;right:22px;bottom:22px;z-index:1000;width:46px;height:46px;display:grid;place-items:center;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--green);box-shadow:var(--shadow);font:800 1.35rem/1 system-ui,sans-serif;cursor:pointer;opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .2s ease,transform .2s ease,visibility .2s ease,border-color .2s ease}
    .sosqlik-back-to-top.is-visible{opacity:1;visibility:visible;transform:translateY(0)}
    .sosqlik-back-to-top:hover{border-color:var(--green);transform:translateY(-2px)}
    .sosqlik-back-to-top:focus-visible{outline:3px solid color-mix(in srgb,var(--green) 35%,transparent);outline-offset:3px}
    @media(max-width:640px){.sosqlik-back-to-top{right:14px;bottom:14px;width:44px;height:44px}}
    @media(prefers-reduced-motion:reduce){.sosqlik-back-to-top{transition:none}}
  </style>

<script is:inline>
/* SOSQLIK - retour en haut */
(() => {
  const button = document.querySelector('#sosqlik-back-to-top');
  if (!button) return;
  const update = () => button.classList.toggle('is-visible', window.scrollY > 500);
  window.addEventListener('scroll', update, { passive: true });
  button.addEventListener('click', () => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
  });
  update();
})();
</script>

<script is:inline>
/* SOSQLIK V4.73 - navigation profonde */
(() => {
  const raw = new URLSearchParams(location.search).get('find');
  if (!raw) return;
  const norm = v => String(v || '').toLocaleLowerCase('fr').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,' ').trim();
  const wanted = norm(raw);
  const visible = el => el && getComputedStyle(el).display !== 'none' && getComputedStyle(el).visibility !== 'hidden';
  const contains = el => norm(el?.textContent).includes(wanted);

  function interactive() {
    return [...document.querySelectorAll('button,a,[role="button"],[data-index],[data-id],.tutorial-nav-item,.tip-nav-item')]
      .filter(el => visible(el) && contains(el))
      .sort((a,b)=>a.textContent.trim().length-b.textContent.trim().length)[0] || null;
  }
  function content() {
    return [...document.querySelectorAll('h1,h2,h3,h4,h5,h6,p,li,pre,code,td,th,article')]
      .filter(el => visible(el) && contains(el))
      .sort((a,b)=>a.textContent.trim().length-b.textContent.trim().length)[0] || null;
  }
  function mark() {
    const el=content();
    if(!el) return false;
    el.classList.add('sosqlik-search-hit');
    el.scrollIntoView({behavior:'smooth',block:'center'});
    setTimeout(()=>el.classList.remove('sosqlik-search-hit'),4200);
    return true;
  }
  function go() {
    const nav=interactive();
    if(nav){
      nav.click();
      setTimeout(()=>{if(!mark()){nav.classList.add('sosqlik-search-hit');nav.scrollIntoView({behavior:'smooth',block:'center'});}},180);
    } else mark();
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',()=>setTimeout(go,100),{once:true});
  else setTimeout(go,100);
})();
</script>

</body>
</html>
